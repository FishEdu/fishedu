{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@components/*": [
        "./app/components/*"
      ],
      "@utils/*": [
        "./app/utils/*"
      ],
      "@images/*": [
        "./assets/images/*"
      ],
      "@hooks/*": [
        "./app/hooks"
      ],
      "@constants/*": [
        "./app/constants"
      ],
      "@services/*": [
        "./app/services"
      ],
      "@types/*": [
        "./app/types"
      ],
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts", 
    "metro.config.js"  
  ]
}
